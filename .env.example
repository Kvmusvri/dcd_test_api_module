# Ключи API (скопировать в .env и заполнить реальными значениями)
REPLICATE_API_TOKEN=
# Модель: google/nano-banana-pro (по умолчанию) или google/nano-banana-2. Пусто = nano-banana-pro
REPLICATE_MODEL=

# Провайдер генерации оклейки — ТОЛЬКО явный (смена = правка + make restart):
#   replicate (по умолчанию) — nano-banana, платно;
#   comfy — локальный Qwen-Image-Edit через ComfyUI (после обучения LoRA).
WRAP_PROVIDER=replicate
COMFY_URL=http://host.docker.internal:8188
# Пост-грейд оклейки (1 = вкл по умолчанию). 0 — диагностика: наружу
# уходит СЫРАЯ генерация без цветовой коррекции (сравнить чистый вывод
# LoRA с финалом). Смена = правка .env + make restart.
WRAP_GRADE=1
# Подмена промпта на тег плёнки — ТОЛЬКО с LoRA, обученной на тегах
# (иначе свотч в image2 работает как референс цвета). Дефолт 0.
WRAP_FILM_TAG=0
# Best-of-N comfy: N кадров за запрос, судья — ΔE к консенсусу референсов
# (тень + свет + полутона), наружу кадр с минимальной худшей точкой, без
# правки пикселей. Время = N × один проход (~минута каждый). Дефолт 2.
WRAP_BEST_OF=2

# Настройки стенда
HOST=0.0.0.0
PORT=8100
